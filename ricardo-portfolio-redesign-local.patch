+    </section>
+  )
+}
diff --git a/src/styles/base.css b/src/styles/base.css
new file mode 100644
index 0000000..31532e6
--- /dev/null
+++ b/src/styles/base.css
@@ -0,0 +1,58 @@
+﻿body {
+  font-family: var(--font-body);
+  font-weight: 400;
+  line-height: 1.65;
+  background: var(--color-background);
+  color: var(--color-text);
+  overflow-wrap: anywhere;
+  transition: color var(--motion-duration) var(--motion-easing),
+    background-color var(--motion-duration) var(--motion-easing);
+}
+#root { min-height: 100svh; }
+a { color: inherit; text-underline-offset: 0.2em; }
+button, select {
+  color: inherit;
+  background: var(--color-surface);
+  border: 1px solid var(--color-control-border);
+  padding: var(--space-1) var(--space-2);
+  min-height: 2.75rem;
+}
+button { cursor: pointer; }
+button[aria-pressed='true'] { color: var(--color-background); background: var(--color-text); }
+:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 4px; }
+h1, h2, h3 { line-height: 1.25; }
+h1 { font-size: 2rem; }
+h2 { font-size: 1.5rem; }
+h3 { font-size: 1.125rem; }
+.container { width: min(100% - 2 * var(--page-gutter), var(--content-width)); margin-inline: auto; }
+[id] { scroll-margin-top: calc(var(--header-height) + var(--space-3)); }
+.site-footer { padding-block: var(--space-3); border-top: 1px solid var(--color-border); }
+.filter-controls { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); }
+.section { padding-block: var(--space-5); }
+.stack > * + * { margin-top: var(--space-2); }
+.provisional { color: var(--color-muted); }
+.project-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
+.project-grid > li { min-width: 0; }
+.about-layout { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-4); align-items: start; }
+.media-placeholder { padding: var(--space-3); border: 1px dashed var(--color-border); }
+.skip-link {
+  position: absolute;
+  z-index: 30;
+  top: 0;
+  left: var(--page-gutter);
+  padding: var(--space-2);
+  background: var(--color-background);
+  transform: translateY(-150%);
+}
+.skip-link:focus { transform: translateY(0); }
+@media (max-width: 40rem) {
+  .project-grid, .about-layout { grid-template-columns: 1fr; }
+  .section { padding-block: var(--space-4); }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    transition-duration: 0ms !important;
+    animation-duration: 0ms !important;
+    scroll-behavior: auto !important;
+  }
+}
diff --git a/src/styles/home.css b/src/styles/home.css
new file mode 100644
index 0000000..9552ebe
--- /dev/null
+++ b/src/styles/home.css
@@ -0,0 +1,41 @@
+.work-section { border-top: 1px solid var(--color-border); }
+.section-eyebrow { font-size: .75rem; font-weight: 650; letter-spacing: .09em; text-transform: uppercase; color: var(--color-muted); }
+.work-heading { display: flex; justify-content: space-between; gap: 3rem; align-items: end; margin-bottom: clamp(2.5rem,5vw,5rem); }
+.work-heading h2,.about-preview h2,.site-footer h2 { font-size: clamp(2.5rem,5vw,5.5rem); line-height: 1.08; font-weight: 500; letter-spacing: -.055em; margin-top: 1rem; }
+.work-intro { max-width: 23rem; color: var(--color-secondary); font-size: .95rem; }
+.work-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: clamp(1.25rem,3vw,3rem); row-gap: clamp(3.5rem,7vw,7rem); }
+.work-card { min-width: 0; }
+.work-card-link { text-decoration: none; display: block; }
+.work-card-media { aspect-ratio: 1.4; overflow: hidden; background: var(--color-surface); display: grid; place-items: center; }
+.work-card-media img { display: block; height: 100%; width: 100%; object-fit: cover; transition: transform .45s ease; }
+.work-card-link:hover .work-card-media img { transform: scale(1.025); }
+.work-card-media-kokoro { background: #e9ded4; }
+.work-card-media-kokoro img { object-fit: contain; width: auto; max-width: 75%; }
+.work-card-media-gu-qi { background: #111d39; }
+.work-card-media-gu-qi img { object-fit: contain; width: 90%; height: 90%; }
+.work-card-meta { display: flex; gap: 1rem; align-items: baseline; padding: 1.1rem 0 .85rem; border-bottom: 1px solid var(--color-border); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--color-muted); }
+.work-card-category { margin-left: auto; }
+.work-card-bottom { display: flex; justify-content: space-between; align-items: start; gap: 1.5rem; padding-top: 1rem; }
+.work-card h3 { font-size: clamp(1.6rem,2.6vw,2.75rem); font-weight: 500; letter-spacing: -.045em; }
+.work-card p { margin-top: .4rem; max-width: 30rem; font-size: .92rem; color: var(--color-secondary); }
+.work-card-arrow { font-size: 1.5rem; line-height: 1; transition: transform .25s ease; }
+.work-card-link:hover .work-card-arrow { transform: translate(3px,-3px); }
+.about-preview { display: grid; grid-template-columns: minmax(0,1.3fr) minmax(0,.7fr); gap: clamp(2rem,7vw,8rem); align-items: center; border-top: 1px solid var(--color-border); margin-top: var(--space-7); }
+.about-preview-copy { max-width: 42rem; }
+.about-preview-copy > p:not(.section-eyebrow) { max-width: 37rem; margin-top: 1.5rem; color: var(--color-secondary); }
+.about-preview-photo { max-width: 32rem; background: var(--color-surface); aspect-ratio: 4/5; overflow: hidden; }
+.about-preview-photo img { width: 100%; height: 100%; object-fit: cover; }
+.site-footer { padding-block: var(--space-5) var(--space-3); }
+.footer-main { display: flex; justify-content: space-between; align-items: end; gap: 2rem; padding-bottom: var(--space-6); }
+.footer-main p { max-width: 29rem; margin-top: 1rem; color: var(--color-secondary); }
+.footer-email { font-size: clamp(1rem,1.6vw,1.4rem); overflow-wrap: anywhere; }
+.footer-email span { display: inline-block; }
+.footer-bottom { display: flex; justify-content: space-between; gap: 1rem; padding-top: var(--space-2); border-top: 1px solid var(--color-border); font-size: .8rem; color: var(--color-secondary); }
+.footer-links { display: flex; flex-wrap: wrap; gap: 1.5rem; }
+@media (max-width: 50rem) { .work-heading,.footer-main { display: block; } .work-intro,.footer-email { display: inline-block; margin-top: 1.5rem; } .about-preview { grid-template-columns: 1fr; } .about-preview-photo { width: min(100%,30rem); } }
+@media (max-width: 40rem) { .work-grid { grid-template-columns: 1fr; row-gap: 3.5rem; } .work-heading { margin-bottom: 2rem; } .footer-bottom { flex-direction: column; } .footer-links { gap: 1rem; } .about-preview { margin-top: var(--space-5); } }
+@media (prefers-reduced-motion: reduce) { .work-card-media img,.work-card-arrow { transition: none; } }
+.case-back { padding-block: .75rem; font-size: .8rem; }
+.case-back a { color: var(--color-secondary); text-decoration: none; }
+.case-back a:hover { color: var(--color-text); text-decoration: underline; }
+.case-shell > .site-footer { background: var(--color-background); color: var(--color-text); }
diff --git a/src/styles/reset.css b/src/styles/reset.css
