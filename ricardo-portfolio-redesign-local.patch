-/* ✨ PHASE 8.1 — GLOBAL SCROLL PROGRESS & ROUTE TRANSITIONS */
-
-html {
-  scroll-behavior: smooth;
-}
-
-body {
-  overflow-x: hidden;
-}
-
-/* Top scroll progress */
-
-.scroll-progress {
-  position: fixed;
-  inset: 0 0 auto;
-  z-index: 1200;
-  height: 3px;
-  pointer-events: none;
-  transform-origin: left center;
-  background:
-    linear-gradient(
-      90deg,
-      rgba(255, 255, 255, 0.82),
-      rgba(125, 220, 255, 0.92),
-      rgba(216, 181, 106, 0.92)
-    );
-  box-shadow:
-    0 0 12px rgba(125, 220, 255, 0.34),
-    0 0 28px rgba(255, 255, 255, 0.12);
-}
-
-/* Route transition wrapper */
-
-.page-transition {
-  position: relative;
-  min-height: 100vh;
-  transform-origin: center top;
-  will-change: transform, opacity, filter;
-}
-
-/* Subtle page veil used while routes change */
-
-.page-transition::before {
-  content: "";
-  position: fixed;
-  inset: 0;
-  z-index: 1150;
-  pointer-events: none;
-  opacity: 0;
-  background:
-    radial-gradient(
-      circle at center,
-      rgba(255, 255, 255, 0.035),
-      transparent 52%
-    ),
-    rgba(2, 5, 10, 0.08);
-  backdrop-filter: blur(0);
-  transition:
-    opacity 350ms ease,
-    backdrop-filter 350ms ease;
-}
-
-/* Keep navbar above route content but below progress */
-
-.main-navbar {
-  z-index: 1190;
-}
-
-/* Prevent anchor targets from hiding under fixed navbar */
-
-#home,
-#projects,
-#about,
-#contact,
-#overview,
-#kokoro-overview,
-#guqi-overview,
-#bts-overview {
-  scroll-margin-top: 7rem;
-}
-
-@media (max-width: 768px) {
-  .scroll-progress {
-    height: 2px;
-  }
-
-  #home,
-  #projects,
-  #about,
-  #contact,
-  #overview,
-  #kokoro-overview,
-  #guqi-overview,
-  #bts-overview {
-    scroll-margin-top: 5.5rem;
-  }
-}
-
-@media (prefers-reduced-motion: reduce) {
-  html {
-    scroll-behavior: auto;
-  }
-
-  .scroll-progress,
-  .page-transition {
-    animation: none !important;
-    transition-duration: 0.01ms !important;
-  }
-}
-
-/* ✨ PHASE 8.2 — PREMIUM MICROINTERACTIONS */
-
-/* Shared pointer-reactive surface */
-
-.pointer-surface {
-  position: relative;
-  min-width: 0;
-  transform:
-    perspective(1200px)
-    rotateX(var(--surface-rotate-x, 0deg))
-    rotateY(var(--surface-rotate-y, 0deg));
-  transform-style: preserve-3d;
-  transition:
-    transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
-  will-change: transform;
-}
-
-.pointer-surface::before {
-  content: "";
-  position: absolute;
-  inset: 0;
-  z-index: 6;
-  border-radius: inherit;
-  pointer-events: none;
-  opacity: 0;
-  background:
-    radial-gradient(
-      var(--pointer-glow-size, 380px)
-      circle at
-      var(--pointer-x, 50%)
-      var(--pointer-y, 50%),
-      rgba(255, 255, 255, 0.16),
-      transparent 42%
-    );
-  mix-blend-mode: screen;
-  transition: opacity 300ms ease;
-}
-
-.pointer-surface:hover::before {
-  opacity: 1;
-}
-
-/* Project cards */
-
-.project-card-surface {
-  height: 100%;
