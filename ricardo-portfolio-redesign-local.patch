+/* ✨ FASE 9.1.4 — FINAL NAVBAR POLISH */
+
+.main-navbar {
+  --navbar-ease: cubic-bezier(0.22, 1, 0.36, 1);
+  transition:
+    padding 420ms var(--navbar-ease),
+    transform 420ms var(--navbar-ease);
+}
+
+.main-navbar::before {
+  transition:
+    opacity 420ms ease,
+    background 420ms ease;
+}
+
+.main-navbar-inner {
+  transition:
+    padding 420ms var(--navbar-ease),
+    transform 420ms var(--navbar-ease);
+}
+
+.main-navbar-inner::before {
+  transition:
+    border-color 420ms ease,
+    background 420ms ease,
+    box-shadow 420ms ease,
+    backdrop-filter 420ms ease;
+}
+
+.main-navbar-scrolled {
+  padding-top: 0.8rem;
+  padding-bottom: 0.8rem;
+}
+
+.main-navbar-scrolled::before {
+  opacity: 0.48;
+  background:
+    linear-gradient(
+      180deg,
+      rgba(0, 0, 0, 0.5) 0%,
+      rgba(0, 0, 0, 0.2) 54%,
+      transparent 100%
+    );
+}
+
+.main-navbar-scrolled .main-navbar-inner {
+  padding-top: 0.7rem;
+  padding-bottom: 0.7rem;
+}
+
+.main-navbar-scrolled .main-navbar-inner::before {
+  border-color: rgba(255, 255, 255, 0.13);
+  background:
+    linear-gradient(
+      180deg,
+      rgba(255, 255, 255, 0.105) 0%,
+      rgba(8, 12, 20, 0.58) 48%,
+      rgba(2, 5, 10, 0.78) 100%
+    );
+  backdrop-filter: blur(18px) saturate(1.12);
+  box-shadow:
+    0 18px 54px rgba(0, 0, 0, 0.3),
+    inset 0 1px 0 rgba(255, 255, 255, 0.08),
+    0 1px 0 rgba(255, 255, 255, 0.04);
+}
+
+.main-navbar-scrolled .main-navbar-inner::after {
+  opacity: 0.72;
+}
+
+.navbar-logo {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.7rem;
+  isolation: isolate;
+}
+
+.navbar-logo-text {
+  position: relative;
+  z-index: 2;
+  transition:
+    transform 420ms var(--navbar-ease),
+    letter-spacing 420ms var(--navbar-ease);
+}
+
+.navbar-logo-mark {
+  position: relative;
+  width: 5px;
+  height: 5px;
+  flex: 0 0 auto;
+  border-radius: 999px;
+  background: rgba(255, 255, 255, 0.9);
+  opacity: 0.62;
+  box-shadow:
+    0 0 10px rgba(255, 255, 255, 0.62),
+    0 0 20px rgba(125, 220, 255, 0.18);
+  transform: scale(0.82);
+  transition:
+    opacity 350ms ease,
+    transform 420ms var(--navbar-ease),
+    box-shadow 350ms ease;
+}
+
+.navbar-logo:hover .navbar-logo-text {
+  transform: translateX(2px);
+  letter-spacing: 0.27em;
+}
+
+.navbar-logo:hover .navbar-logo-mark {
+  opacity: 1;
+  transform: scale(1.18);
+  box-shadow:
+    0 0 12px rgba(255, 255, 255, 0.84),
+    0 0 28px rgba(125, 220, 255, 0.28);
+}
+
+.navbar-links button {
+  padding: 0.42rem 0.15rem;
+  isolation: isolate;
+}
+
+.navbar-links button::before {
+  content: "";
+  position: absolute;
+  left: 50%;
+  right: 50%;
+  bottom: -0.5rem;
+  height: 1px;
+  pointer-events: none;
+  opacity: 0;
+  background:
+    linear-gradient(
+      90deg,
+      transparent,
+      rgba(255, 255, 255, 0.7),
+      transparent
+    );
+  transition:
+    left 420ms var(--navbar-ease),
+    right 420ms var(--navbar-ease),
+    opacity 300ms ease;
+}
+
+.navbar-links button:hover::before,
+.navbar-links button:focus-visible::before {
+  left: 8%;
+  right: 8%;
+  opacity: 0.68;
+}
+
+.navbar-link-active::before {
+  opacity: 0 !important;
+}
+
+.navbar-active-indicator {
+  width: 18px;
+  height: 2px;
+  border-radius: 999px;
+  background:
+    linear-gradient(
+      90deg,
+      rgba(255, 255, 255, 0.3),
+      #ffffff,
+      rgba(255, 255, 255, 0.3)
+    );
+  box-shadow:
+    0 0 10px rgba(255, 255, 255, 0.7),
+    0 0 22px rgba(125, 220, 255, 0.22);
+}
+
+.navbar-menu-button {
+  transition:
+    transform 420ms var(--navbar-ease),
+    border-color 300ms ease,
+    background 300ms ease,
+    box-shadow 300ms ease;
+}
+
+.navbar-menu-button:hover {
+  transform: translateY(-2px) rotate(2deg);
+  border-color: rgba(255, 255, 255, 0.28);
+  background: rgba(255, 255, 255, 0.1);
+  box-shadow:
+    0 12px 30px rgba(0, 0, 0, 0.2),
+    0 0 20px rgba(255, 255, 255, 0.08);
+}
+
+.main-navbar-menu-open .navbar-menu-button {
+  transform: rotate(90deg);
+}
+
+@media (max-width: 768px) {
+  .main-navbar-scrolled {
+    padding: 0.7rem 1rem;
+  }
+
+  .main-navbar-scrolled .main-navbar-inner {
+    padding: 0.68rem 0.82rem;
+  }
+
+  .navbar-logo-mark {
+    width: 4px;
+    height: 4px;
+  }
+
+  .navbar-links {
+    transform:
+      translateY(-14px)
+      scale(0.98);
+    transform-origin: top center;
+    transition:
+      opacity 320ms ease,
+      transform 420ms var(--navbar-ease),
+      border-color 300ms ease,
+      box-shadow 300ms ease;
+  }
+
+  .navbar-links-open {
+    transform:
+      translateY(0)
+      scale(1);
+    border-color: rgba(255, 255, 255, 0.16);
+    box-shadow:
+      0 26px 70px rgba(0, 0, 0, 0.4),
+      inset 0 1px 0 rgba(255, 255, 255, 0.06);
+  }
+
+  .navbar-links button {
+    position: relative;
+    overflow: hidden;
+    transition:
+      color 280ms ease,
+      background 280ms ease,
+      transform 420ms var(--navbar-ease),
+      padding-left 420ms var(--navbar-ease);
+  }
+
+  .navbar-links button::before {
+    left: 0;
+    right: auto;
+    bottom: 0;
+    width: 2px;
+    height: 100%;
+    opacity: 0;
+    background:
+      linear-gradient(
+        180deg,
+        transparent,
+        rgba(255, 255, 255, 0.86),
+        transparent
+      );
+  }
+
+  .navbar-links button:hover,
+  .navbar-links button:focus-visible,
+  .navbar-links .navbar-link-active {
+    padding-left: 1.25rem;
+    transform: translateX(2px);
+    background: rgba(255, 255, 255, 0.075);
+  }
+
+  .navbar-links button:hover::before,
+  .navbar-links button:focus-visible::before,
+  .navbar-links .navbar-link-active::before {
+    opacity: 0.9 !important;
+  }
+
+  .navbar-active-indicator {
+    display: none;
+  }
+}
+
+@media (hover: none), (pointer: coarse) {
+  .navbar-logo:hover .navbar-logo-text,
+  .navbar-logo:hover .navbar-logo-mark,
+  .navbar-menu-button:hover {
+    transform: none;
+  }
+
+  .navbar-links button:hover::before {
+    opacity: 0;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .main-navbar,
+  .main-navbar::before,
+  .main-navbar-inner,
+  .main-navbar-inner::before,
+  .navbar-logo-text,
+  .navbar-logo-mark,
+  .navbar-links,
+  .navbar-links button,
+  .navbar-links button::before,
+  .navbar-menu-button,
+  .navbar-active-indicator {
+    transition-duration: 0.01ms !important;
+  }
+
+  .navbar-logo:hover .navbar-logo-text,
+  .navbar-logo:hover .navbar-logo-mark,
+  .navbar-menu-button:hover,
+  .main-navbar-menu-open .navbar-menu-button,
+  .navbar-links button:hover,
+  .navbar-links button:focus-visible,
+  .navbar-links .navbar-link-active {
+    transform: none;
+  }
+}
+
+/* =========================================================
+   FASE 9.2.1 — VISUAL CONSISTENCY SYSTEM
+   Structural normalization without removing each project's identity
+   ========================================================= */
+
+:root {
+  --portfolio-layout: 1280px;
+  --portfolio-layout-wide: 1440px;
+
+  --portfolio-gutter: 2.5rem;
+  --portfolio-gutter-tablet: 1.5rem;
+  --portfolio-gutter-mobile: 1rem;
+
+  --portfolio-section-space: clamp(6.5rem, 8.5vw, 8rem);
+  --portfolio-section-space-compact: clamp(5.5rem, 7vw, 7rem);
+
+  --portfolio-radius-xl: 32px;
+  --portfolio-radius-lg: 24px;
+  --portfolio-radius-md: 18px;
+  --portfolio-radius-sm: 14px;
+  --portfolio-radius-pill: 999px;
+
+  --portfolio-heading-size: clamp(2.5rem, 4.7vw, 4.75rem);
+  --portfolio-heading-line: 1.02;
+  --portfolio-heading-spacing: -0.035em;
+
+  --portfolio-body-size: clamp(1rem, 1.05vw, 1.08rem);
+  --portfolio-body-line: 1.72;
+  --portfolio-copy-max: 760px;
+
+  --portfolio-label-size: 0.72rem;
+  --portfolio-label-spacing: 0.24em;
+
+  --portfolio-ease: cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+/* ---------- SHARED CASE-STUDY LAYOUT ---------- */
+
+.aura-section,
+.kokoro-section,
+.guqi-section,
+.bts-section {
+  width: min(
+    var(--portfolio-layout),
+    calc(100% - (var(--portfolio-gutter) * 2))
+  );
+  padding-top: var(--portfolio-section-space);
+  padding-bottom: var(--portfolio-section-space);
+}
+
+.aura-wide-section,
+.kokoro-wide-section,
+.guqi-wide-section,
+.bts-wide-section {
+  width: min(
+    var(--portfolio-layout-wide),
+    calc(100% - (var(--portfolio-gutter) * 2))
+  );
+}
+
+.aura-section-intro,
+.aura-section-heading,
+.kokoro-section-heading,
+.guqi-section-heading,
+.bts-section-heading {
+  max-width: 820px;
+  margin-bottom: 3rem;
+}
+
+.aura-section-intro-large,
+.aura-section-intro-wide,
+.kokoro-section-heading-large,
+.guqi-section-heading-large,
+.bts-section-heading-large {
+  max-width: 980px;
+}
+
+.aura-section h2,
+.aura-prototype-cta h2,
+.kokoro-section h2,
+.kokoro-prototype-cta h2,
+.guqi-section h2,
+.guqi-live-cta h2,
+.bts-section h2,
+.bts-trailer-cta h2 {
+  font-size: var(--portfolio-heading-size);
+  line-height: var(--portfolio-heading-line);
+  letter-spacing: var(--portfolio-heading-spacing);
+}
+
+.aura-section p,
+.aura-prototype-cta p,
+.kokoro-section p,
+.kokoro-prototype-cta p,
+.guqi-section p,
+.guqi-live-cta p,
+.bts-section p,
+.bts-trailer-cta p {
+  font-size: var(--portfolio-body-size);
+  line-height: var(--portfolio-body-line);
+}
+
+.aura-section-label,
+.aura-kicker,
+.kokoro-section-label,
+.kokoro-kicker,
+.guqi-section-label,
+.guqi-kicker,
+.bts-section-label,
+.bts-kicker {
+  font-size: var(--portfolio-label-size);
+  letter-spacing: var(--portfolio-label-spacing);
+}
+
+.aura-section-intro p,
+.kokoro-section-intro,
+.guqi-section-intro,
+.bts-section-intro {
+  max-width: var(--portfolio-copy-max);
+}
+
+/* ---------- OVERVIEW ALIGNMENT ---------- */
+
+.aura-overview-grid,
+.kokoro-overview-grid,
+.guqi-overview-grid,
+.bts-overview-grid {
+  grid-template-columns:
+    minmax(0, 1.08fr)
+    minmax(340px, 0.92fr);
+  gap: clamp(3rem, 5vw, 5rem);
+}
+
+.aura-overview-copy,
+.kokoro-overview-copy,
+.guqi-overview-copy,
+.bts-overview-copy {
+  max-width: 720px;
+}
+
+.aura-overview-copy h2,
+.kokoro-overview-copy h2,
+.guqi-overview-copy h2,
+.bts-overview-copy h2 {
+  max-width: 700px;
+}
+
+/* ---------- GLOBAL CARD RADII ---------- */
+
+.project-card-link,
+.aura-meta-card,
+.aura-info-card,
+.aura-system-card,
+.aura-flow-step,
+.aura-media-card,
+.aura-decision-card,
+.aura-demo-card,
+.aura-reflection-card,
+.kokoro-meta-card,
+.kokoro-info-card,
+.kokoro-user-card,
+.kokoro-principle-card,
+.kokoro-journey-step,
+.kokoro-phone-card,
+.kokoro-video-card,
+.kokoro-final-card,
+.kokoro-reflection-card,
+.guqi-meta-card,
+.guqi-info-card,
+.guqi-priority-card,
+.guqi-flow-step,
+.guqi-image-card,
+.guqi-decision-card,
+.guqi-final-card,
+.guqi-reflection-card,
+.bts-meta-card,
+.bts-info-card,
+.bts-user-card,
+.bts-goal-card,
+.bts-benchmark-card,
+.bts-before-after,
+.bts-decision-card,
+.bts-trailer-card,
+.bts-reflection-card,
+.contact-card,
+.about-photo-card {
+  border-radius: var(--portfolio-radius-xl);
+}
+
+.aura-media-frame,
+.aura-demo-video,
+.kokoro-phone-frame,
+.guqi-final-media,
+.bts-image-frame,
+.bts-reference-image,
+.bts-trailer-video,
+.contact-resource,
+.contact-status-card,
+.about-focus-card {
+  border-radius: var(--portfolio-radius-lg);
+}
+
+.aura-primary-link,
+.aura-secondary-link,
+.kokoro-primary-link,
+.guqi-primary-link,
+.guqi-secondary-link,
+.bts-primary-link,
+.about-button,
+.about-secondary-link,
+.contact-primary-action {
+  border-radius: var(--portfolio-radius-pill);
+}
+
+/* ---------- ABOUT NORMALIZATION ---------- */
+
+.about-section {
+  padding-top: clamp(9rem, 11vw, 10.5rem);
+  padding-bottom: clamp(7rem, 9vw, 8.5rem);
+}
+
+.about-content {
+  max-width: var(--portfolio-layout);
+  gap: clamp(3rem, 5vw, 4.5rem);
+}
+
+.about-title {
+  max-width: 760px;
+  font-size: clamp(3rem, 5vw, 5.15rem);
+  line-height: 0.94;
+}
+
+.about-lead,
+.about-copy {
+  max-width: 41rem;
+}
+
+.about-focus-grid {
+  gap: 0.9rem;
+}
+
+.about-focus-card {
+  min-height: 76px;
+  padding: 1.05rem 1.15rem;
+}
+
+.about-process {
+  margin-top: 2.15rem;
+}
+
+.about-actions {
+  margin-top: 2.3rem;
+}
+
+/* ---------- CONTACT NORMALIZATION ---------- */
+
+.contact-content {
+  max-width: var(--portfolio-layout);
+  grid-template-columns:
+    minmax(0, 0.96fr)
+    minmax(390px, 1.04fr);
+  gap: clamp(3.5rem, 5vw, 5rem);
+}
+
+.contact-title {
+  font-size: clamp(3.15rem, 5.4vw, 5.55rem);
+  line-height: 0.94;
+}
+
+.contact-card {
+  border-radius: var(--portfolio-radius-xl);
+  padding: 1.15rem;
+}
+
+.contact-card-header {
+  padding: 1.15rem 1.1rem 1.3rem;
+}
+
+.contact-resource {
+  min-height: 76px;
+}
+
+.contact-status-grid {
+  gap: 0.9rem;
+}
+
+.contact-status-card {
+  min-height: 104px;
+}
+
+/* ---------- PROJECTS NORMALIZATION ---------- */
+
+.projects-content {
+  max-width: var(--portfolio-layout);
+}
+
+.projects-header {
+  gap: clamp(2.5rem, 6vw, 5rem);
+}
+
+.projects-title {
+  font-size: clamp(4.4rem, 7.5vw, 7rem);
+  line-height: 0.94;
+}
+
+.project-card-link {
+  border-radius: var(--portfolio-radius-xl);
+}
+
+.project-card-media {
+  min-height: 255px;
+}
+
+.project-card-content {
+  padding: 1.65rem 1.55rem 1.5rem;
+}
+
+.project-card-footer {
+  padding: 1.15rem 1.55rem 1.3rem;
+}
+
+/* ---------- GU-QI VERTICAL RHYTHM FIX ---------- */
+
+/*
+  The Discovery cards had excessive empty vertical space before
+  Experience Priorities. These rules keep the editorial composition
+  but remove the visual interruption.
+*/
+
+.guqi-discovery-layout {
+  align-items: stretch;
+}
+
+.guqi-discovery-layout + .guqi-section,
+.guqi-section:has(.guqi-discovery-layout) {
+  padding-bottom: clamp(4rem, 5vw, 5.5rem);
+}
+
+.guqi-section:has(.guqi-priorities-layout) {
+  padding-top: clamp(4rem, 5vw, 5.5rem);
+}
+
+.guqi-discovery-main,
+.guqi-development-main,
+.guqi-info-card-featured {
+  min-height: 300px;
+}
+
+/* Fallback for browsers without :has() support */
+@supports not selector(:has(*)) {
+  .guqi-discovery-layout {
+    margin-bottom: -2.25rem;
+  }
+}
+
+/* ---------- KOKORO EDITORIAL CONSISTENCY ---------- */
+
+.kokoro-discovery-layout,
+.kokoro-checkout-layout,
+.kokoro-customization-feature {
+  gap: clamp(1.25rem, 2.2vw, 2rem);
+}
+
+.kokoro-phone-card {
+  border-radius: var(--portfolio-radius-xl);
+}
+
+.kokoro-phone-frame {
+  border-radius: var(--portfolio-radius-lg);
+}
+
+.kokoro-customization-strip {
+  gap: 1.25rem;
+}
+
+/* ---------- BTS NESTED RADIUS CONSISTENCY ---------- */
+
+.bts-before-after {
+  border-radius: var(--portfolio-radius-xl);
+}
+
+.bts-ba-media {
+  gap: 1rem;
+}
+
+.bts-image-frame,
+.bts-reference-image {
+  border-radius: var(--portfolio-radius-lg);
+}
+
+.bts-image-frame img,
+.bts-reference-image img {
+  border-radius: calc(var(--portfolio-radius-lg) - 6px);
+}
+
+/* ---------- FINAL CTA ALIGNMENT ---------- */
+
+.aura-prototype-cta-inner,
+.kokoro-prototype-cta-inner,
+.guqi-live-cta-inner,
+.bts-trailer-cta-inner {
+  width: min(
+    var(--portfolio-layout),
+    calc(100% - (var(--portfolio-gutter) * 2))
+  );
+  margin-inline: auto;
+}
+
+.aura-prototype-cta h2,
+.kokoro-prototype-cta h2,
+.guqi-live-cta h2,
+.bts-trailer-cta h2 {
+  max-width: 940px;
+}
+
+/* ---------- TABLET ---------- */
+
+@media (max-width: 1024px) {
+  :root {
+    --portfolio-gutter: var(--portfolio-gutter-tablet);
+    --portfolio-section-space: 6rem;
+  }
+
+  .aura-overview-grid,
+  .kokoro-overview-grid,
+  .guqi-overview-grid,
+  .bts-overview-grid {
+    grid-template-columns: 1fr;
+    gap: 3rem;
+  }
+
+  .about-content,
+  .contact-content {
+    gap: 3.5rem;
+  }
+
+  .about-title,
+  .contact-title {
+    max-width: 760px;
+  }
+
+  .guqi-section:has(.guqi-discovery-layout),
+  .guqi-section:has(.guqi-priorities-layout) {
+    padding-top: 5.5rem;
+    padding-bottom: 5.5rem;
+  }
+}
+
+/* ---------- MOBILE ---------- */
+
+@media (max-width: 768px) {
+  :root {
+    --portfolio-gutter: var(--portfolio-gutter-mobile);
+    --portfolio-section-space: 5rem;
+    --portfolio-heading-size: clamp(2.25rem, 11vw, 3.6rem);
+  }
+
+  .aura-section,
+  .kokoro-section,
+  .guqi-section,
+  .bts-section,
+  .aura-wide-section,
+  .kokoro-wide-section,
+  .guqi-wide-section,
+  .bts-wide-section {
+    width: calc(100% - 2rem);
+  }
+
+  .aura-section-intro,
+  .aura-section-heading,
+  .kokoro-section-heading,
+  .guqi-section-heading,
+  .bts-section-heading {
+    margin-bottom: 2.25rem;
+  }
+
+  .about-section,
+  .contact-section {
+    padding-left: 1rem;
+    padding-right: 1rem;
+  }
+
+  .about-title,
+  .contact-title {
+    font-size: clamp(2.8rem, 13vw, 4.25rem);
+  }
+
+  .project-card-content {
+    padding: 1.4rem 1.25rem 1.3rem;
+  }
+
+  .project-card-footer {
+    padding: 1.05rem 1.25rem 1.2rem;
+  }
+
+  .guqi-discovery-layout {
+    margin-bottom: 0;
+  }
+
+  .guqi-section:has(.guqi-discovery-layout),
+  .guqi-section:has(.guqi-priorities-layout) {
+    padding-top: 5rem;
+    padding-bottom: 5rem;
+  }
+
+  .bts-ba-media {
+    gap: 0.85rem;
+  }
+}
+
+/* ---------- SMALL MOBILE ---------- */
+
+@media (max-width: 480px) {
+  .aura-section,
+  .kokoro-section,
+  .guqi-section,
+  .bts-section,
+  .aura-wide-section,
+  .kokoro-wide-section,
+  .guqi-wide-section,
+  .bts-wide-section {
+    width: calc(100% - 1.5rem);
+  }
+
+  .about-focus-card,
+  .contact-status-card,
+  .contact-resource {
+    border-radius: var(--portfolio-radius-md);
+  }
+
+  .project-card-link,
+  .aura-meta-card,
+  .aura-info-card,
+  .aura-system-card,
+  .aura-flow-step,
+  .aura-media-card,
+  .aura-decision-card,
+  .aura-demo-card,
+  .aura-reflection-card,
+  .kokoro-meta-card,
+  .kokoro-info-card,
+  .kokoro-user-card,
+  .kokoro-principle-card,
+  .kokoro-journey-step,
+  .kokoro-phone-card,
+  .kokoro-video-card,
+  .kokoro-final-card,
+  .kokoro-reflection-card,
+  .guqi-meta-card,
+  .guqi-info-card,
+  .guqi-priority-card,
+  .guqi-flow-step,
+  .guqi-image-card,
+  .guqi-decision-card,
+  .guqi-final-card,
+  .guqi-reflection-card,
+  .bts-meta-card,
+  .bts-info-card,
+  .bts-user-card,
+  .bts-goal-card,
+  .bts-benchmark-card,
+  .bts-before-after,
+  .bts-decision-card,
+  .bts-trailer-card,
+  .bts-reflection-card,
+  .contact-card,
+  .about-photo-card {
+    border-radius: var(--portfolio-radius-lg);
+  }
+}
+
+/* ---------- REDUCED MOTION ---------- */
+
+@media (prefers-reduced-motion: reduce) {
+  .about-focus-card,
+  .contact-status-card,
+  .contact-resource,
+  .contact-card {
+    transition-duration: 0.01ms !important;
+  }
+}
+
+/* =========================================================
+   FASE 9.2.1 — FINAL CTA WIDTH CORRECTION
+   The outer CTA controls the global width. The inner panel
+   must fill it completely to avoid visible side blocks.
+   ========================================================= */
+
+.aura-prototype-cta-inner,
+.kokoro-prototype-cta-inner,
+.guqi-live-cta-inner,
+.bts-trailer-cta-inner {
+  width: 100%;
+  max-width: none;
+  margin: 0;
+  box-sizing: border-box;
+}
+
+/* Keep identical structural dimensions across all case-study CTAs */
+
+.aura-prototype-cta,
+.kokoro-prototype-cta,
+.guqi-live-cta,
+.bts-trailer-cta {
+  width: min(
+    var(--portfolio-layout-wide),
+    calc(100% - 3rem)
+  );
+  border-radius: 36px;
+}
+
+.aura-prototype-cta-inner,
+.kokoro-prototype-cta-inner,
+.guqi-live-cta-inner,
+.bts-trailer-cta-inner {
+  min-height: 470px;
+  padding: clamp(3rem, 5vw, 4rem);
+  border-radius: 35px;
+}
+
+@media (max-width: 768px) {
+  .aura-prototype-cta,
+  .kokoro-prototype-cta,
+  .guqi-live-cta,
+  .bts-trailer-cta {
+    width: calc(100% - 2rem);
+  }
+
+  .aura-prototype-cta-inner,
+  .kokoro-prototype-cta-inner,
+  .guqi-live-cta-inner,
+  .bts-trailer-cta-inner {
+    min-height: 400px;
+    padding: 2rem;
+  }
+}
+
+@media (max-width: 480px) {
+  .aura-prototype-cta,
+  .kokoro-prototype-cta,
+  .guqi-live-cta,
+  .bts-trailer-cta {
+    width: calc(100% - 1.5rem);
+    border-radius: 26px;
+  }
+
+  .aura-prototype-cta-inner,
+  .kokoro-prototype-cta-inner,
+  .guqi-live-cta-inner,
+  .bts-trailer-cta-inner {
+    min-height: 350px;
+    padding: 1.5rem;
+    border-radius: 25px;
+  }
+}
