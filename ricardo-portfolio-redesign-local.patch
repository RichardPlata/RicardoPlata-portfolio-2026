diff --git a/src/pages/CaseStudy.jsx b/src/pages/CaseStudy.jsx
new file mode 100644
index 0000000..04ade13
--- /dev/null
+++ b/src/pages/CaseStudy.jsx
@@ -0,0 +1,46 @@
+import { lazy, useEffect } from 'react'
+import { Link, Navigate, useParams } from 'react-router-dom'
+import { useTranslation } from 'react-i18next'
+import Header from '../components/Header.jsx'
+import Footer from '../components/Footer.jsx'
+import NotFound from './NotFound.jsx'
+import { professionalProjects } from '../data/projects.js'
+
+const cases = {
+  'aura-drive': lazy(() => import('./AuraDrive.jsx')),
+  kokoro: lazy(() => import('./Kokoro.jsx')),
+  'gu-qi': lazy(() => import('./GuQi.jsx')),
+  'beyond-the-shadows': lazy(() => import('./BeyondTheShadows.jsx')),
+}
+
+export default function CaseStudy() {
+  const { lang, slug } = useParams()
+  const { i18n, t } = useTranslation()
+  const project = professionalProjects.find((item) => item.slug === slug)
+  const Component = cases[slug]
+  const supported = lang === 'en' || lang === 'es'
+
+  useEffect(() => {
+    if (!supported || !Component) return
+    i18n.changeLanguage(lang)
+    document.documentElement.lang = lang
+    document.title = `${project.title} | Ricardo Plata`
+    window.scrollTo(0, 0)
+  }, [lang, slug, i18n, Component, project, supported])
+
+  if (!supported) return <Navigate to="/en" replace />
+  if (!Component) return <><Header /><main className="container"><NotFound /></main><Footer /></>
+  if (i18n.resolvedLanguage !== lang) return null
+
+  return (
+    <div className="case-shell">
+      <a className="skip-link" href="#case-content">{t('skip')}</a>
+      <Header />
+      <div className="case-back container">
+        <Link to={`/${lang}#projects`}>{t('projectIndex.back')} <span aria-hidden="true">↗</span></Link>
+      </div>
+      <div id="case-content" tabIndex={-1}><Component /></div>
+      <Footer />
+    </div>
+  )
+}
