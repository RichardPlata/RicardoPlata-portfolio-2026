+  --color-focus: #303740;
+  --font-body: 'Manrope Variable', system-ui, sans-serif;
+  --space-0: 0.25rem;
+  --space-1: 0.5rem;
+  --space-2: 1rem;
+  --space-3: 1.5rem;
+  --space-4: 2rem;
+  --space-5: 4rem;
+  --space-6: clamp(4rem, 7vw, 7rem);
+  --space-7: clamp(6rem, 10vw, 10rem);
+  --radius-small: 0.25rem;
+  --radius-medium: 0.5rem;
+  --radius-large: 0.75rem;
+  --content-width: 90rem;
+  --page-gutter: clamp(1.25rem, 4vw, 4rem);
+  --header-height: 5.5rem;
+  --motion-duration: 180ms;
+  --motion-easing: cubic-bezier(0.2, 0, 0.2, 1);
+}
+:root[data-theme='dark'] {
+  color-scheme: dark;
+  --color-background: var(--color-dark-background);
+  --color-surface: #23262a;
+  --color-elevated: #2b2e33;
+  --color-text: #eff1f3;
+  --color-secondary: #c1c6cd;
+  --color-muted: #a0a8b2;
+  --color-border: #383d44;
+  --color-control-border: #7d8794;
+  --color-focus: #e4e9ef;
+}
+@media (max-width: 56rem) {
+  :root { --header-height: 4.5rem; }
