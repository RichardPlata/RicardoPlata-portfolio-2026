-    translate3d(
-      var(--magnetic-x),
-      var(--magnetic-y),
-      0
-    );
-  transition:
-    transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
-    color 250ms ease,
-    background 250ms ease,
-    border-color 250ms ease,
-    box-shadow 250ms ease;
-  will-change: transform;
