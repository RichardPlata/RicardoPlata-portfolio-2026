+import { Link, useParams } from 'react-router-dom'
+import { useTranslation } from 'react-i18next'
+
+export default function ProjectGrid({ projects }) {
+  const { t } = useTranslation('projects')
+  const { lang } = useParams()
+  return (
+    <ol className="work-grid">
+      {projects.map((project, index) => (
+        <li key={project.slug} className="work-card">
+          <Link className="work-card-link" to={`/${lang}/work/${project.slug}`}
+            aria-label={t('open', { title: project.title })}>
+            <div className={`work-card-media work-card-media-${project.slug}`}>
+              <img src={project.image} alt={t(`${project.slug}.alt`)}
+                loading="lazy" decoding="async" width="1600" height="1050" />
+            </div>
+            <div className="work-card-meta">
+              <span className="work-card-number">{String(index + 1).padStart(2, '0')}</span>
+              <span className="work-card-category">{t(`${project.slug}.category`)}</span>
+              <span className="work-card-year">{project.year}</span>
+            </div>
+            <div className="work-card-bottom">
+              <div>
+                <h3>{project.title}</h3>
+                <p>{t(`${project.slug}.description`)}</p>
+              </div>
+              <span className="work-card-arrow" aria-hidden="true">↗</span>
+            </div>
+          </Link>
+        </li>
+      ))}
+    </ol>
+  )
+}
