diff --git a/src/styles/case.css b/src/styles/case.css
index a91980f..bd953eb 100644
--- a/src/styles/case.css
+++ b/src/styles/case.css
@@ -28,3 +28,18 @@
 .case-story { max-width: 49rem; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1.5rem; }
 .case-ending { max-width: 49rem; padding-left: 4rem; }
 @media (max-width: 40rem) { .case-ending { padding-left: 0; } }
+
+/* A restrained editorial rhythm leaves room for screenshots without stretching the copy. */
+.case-intro { max-width: 38rem; }
+.case-intro h1 { font-size: clamp(2.75rem, 5vw, 4.5rem); }
+.case-lead { font-size: clamp(1.25rem, 2vw, 1.55rem); }
+.case-article > .case-media, .case-chapter > .case-media { width: min(100%, 42rem); }
+.case-story { max-width: 38rem; margin-block: clamp(3rem, 6vw, 5rem); }
+.case-story > p, .case-story div > p, .case-ending p { font-size: 1rem; line-height: 1.8; }
+.case-chapter h2, .case-ending h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); }
+.case-ending { max-width: 38rem; }
+.case-decision { width: min(100%, 38rem); margin: clamp(4rem, 8vw, 7rem) auto; padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: var(--radius-large); background: var(--color-surface); }
+.case-decision-label { color: var(--color-secondary); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
+.case-decision h2 { margin: .75rem 0 1.75rem; font-size: 1.4rem; line-height: 1.3; letter-spacing: -.025em; }
+.case-decision h3 { margin-top: 1.6rem; font-size: 1rem; }
+.case-decision p:not(.case-decision-label) { margin-top: .5rem; color: var(--color-secondary); font-size: 1rem; line-height: 1.7; }
