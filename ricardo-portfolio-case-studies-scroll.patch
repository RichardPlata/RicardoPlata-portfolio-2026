+.case-decision { width: min(100%, 62rem); margin: clamp(5rem, 12vw, 10rem) auto; padding: clamp(1.5rem, 5vw, 3.5rem); border: 1px solid var(--color-border); border-radius: var(--radius-large); background: var(--color-surface); }
+.case-decision-label { margin-bottom: .75rem; }
+.case-decision h2 { max-width: 30ch; margin-bottom: 2rem; font-size: clamp(1.5rem, 3vw, 2.5rem); line-height: 1.15; letter-spacing: -.04em; }
+.case-decision-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
+.case-decision h3 { font-size: .82rem; text-transform: uppercase; letter-spacing: .08em; }
+.case-decision p { margin-top: .5rem; color: var(--color-secondary); line-height: 1.7; }
+.case-ending { width: min(100%, 46rem); margin: clamp(4rem, 10vw, 9rem) auto; text-align: center; }
+.case-ending .case-kicker { margin-bottom: .8rem; }
+.case-ending p:last-child { max-width: 58ch; margin-inline: auto; }
+.case-return { display: block; width: fit-content; margin: 0 auto; font-size: .82rem; text-underline-offset: .3em; }
 .case-shell > .site-footer { background: var(--color-background); color: var(--color-text); }
