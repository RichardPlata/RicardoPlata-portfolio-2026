+  [data-case-reveal][data-revealed='true'] .case-media-frame { animation: case-media-reveal 1000ms cubic-bezier(.22,1,.36,1) 90ms both; }
+  [data-case-reveal][data-revealed='true'] .case-media img { animation: case-image-settle 1200ms cubic-bezier(.22,1,.36,1) 90ms both; }
