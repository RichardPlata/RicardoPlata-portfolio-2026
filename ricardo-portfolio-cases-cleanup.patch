+import { useEffect } from 'react'
+import { Link, Navigate, useParams } from 'react-router-dom'
+import { useTranslation } from 'react-i18next'
+import Header from '../components/Header.jsx'
+import Footer from '../components/Footer.jsx'
+import NotFound from './NotFound.jsx'
+import { caseStudies } from '../data/caseStudies.js'
+
+function MediaSlot({ label, image }) {
+  return <figure className={`case-media ${image ? 'case-media--filled' : ''}`}>
+    {image ? <img src={image} alt={label} loading="lazy" decoding="async" /> : <div className="case-media-empty" role="img" aria-label={label}><span>{label}</span></div>}
+    <figcaption>{label}</figcaption>
+  </figure>
+}
+
+export default function CaseStudy() {
+  const { lang, slug } = useParams()
+  const { i18n, t } = useTranslation()
+  const study = caseStudies[slug]
+  const supported = lang === 'en' || lang === 'es'
+  const copy = study?.[lang]
+
+  useEffect(() => {
+    if (!supported || !study) return
+    i18n.changeLanguage(lang)
+    document.documentElement.lang = lang
+    document.title = `${study.title} | Ricardo Plata`
+    window.scrollTo(0, 0)
+  }, [lang, slug, i18n, study, supported])
+
+  if (!supported) return <Navigate to="/en" replace />
+  if (!study) return <div className="case-shell"><Header /><main className="container"><NotFound /></main><Footer /></div>
+  if (i18n.resolvedLanguage !== lang) return null
+
+  return <div className="case-shell">
+    <a className="skip-link" href="#case-content">{t('skip')}</a>
+    <Header />
+    <main id="case-content" className="case-article content-frame" tabIndex={-1}>
+      <Link className="case-return" to={`/${lang}#work`}>{t('projectIndex.back')} ↗</Link>
+      <header className="case-intro">
+        <p className="case-eyebrow">{study.role} · {study.tools}</p>
+        <h1>{study.title}</h1>
+        <p className="case-lead">{copy.intro}</p>
+        {study.link && <a className="case-external" href={study.link} target="_blank" rel="noopener noreferrer">{lang === 'es' ? 'Explorar proyecto' : 'Explore project'} ↗</a>}
+      </header>
+      <MediaSlot label={lang === 'es' ? 'Portada del proyecto · mockup pendiente' : 'Project cover · mockup pending'} image={study.cover} />
+      <div className="case-story"><p>{copy.context}</p></div>
+      {copy.sections.map((section, index) => <section className="case-chapter" key={section.title}>
+        <div className="case-story"><span className="case-number">0{index + 1}</span><div><h2>{section.title}</h2><p>{section.body}</p></div></div>
+        <MediaSlot label={section.media} image={study.media?.[index]} />
+      </section>)}
+      <div className="case-ending"><h2>{lang === 'es' ? 'Lo que sigue' : 'What comes next'}</h2><p>{copy.closing}</p></div>
+      <Link className="case-return" to={`/${lang}#work`}>{t('projectIndex.back')} ↗</Link>
+    </main>
+    <Footer />
+  </div>
+}
