+.contact-orbits { display: block; width: min(100%, 45rem); height: auto; margin: var(--space-3) auto -3rem; position: relative; color: var(--color-accent); pointer-events: none; }
+.orbital-paths { opacity: 0.45; }
+.orbital-indigo { color: var(--color-cosmic-indigo); }
+.orbital-cyan { color: var(--color-cosmic-cyan); }
+.contact-panel { position: relative; border-radius: 2rem; background: var(--contact-panel-background); color: var(--contact-panel-text); padding: clamp(1.5rem, 4vw, 3rem); }
+.contact-panel-top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); }
+.contact-panel-top h2 { font-size: 0.9375rem; font-weight: 500; }
