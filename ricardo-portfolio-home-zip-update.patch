+  .contact-orbits[data-entered='true'] .orbital-bodies { animation: orbit-body-arrive 650ms var(--motion-easing) 70ms backwards; }
+  .contact-orbits[data-entered='true'] .orbital-stars { animation: orbit-path-arrive 500ms ease-out 140ms backwards; }
+}
+@keyframes orbit-path-arrive { from { opacity: 0; } }
+@keyframes orbit-body-arrive { from { opacity: 0; transform: translateY(8px); } }
+@media (max-width: 56rem) {
