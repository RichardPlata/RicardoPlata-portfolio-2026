+.contact-panel-links a, .contact-panel-links button { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0.5rem 0; border: 0; background: transparent; color: inherit; font-size: 0.8125rem; font-weight: 550; text-decoration: none; }
+.contact-panel-links a:hover, .contact-panel-links button:hover { color: inherit; text-decoration: underline; text-underline-offset: 0.25em; }
+.contact-panel :focus-visible { outline-color: var(--contact-panel-text); }
+.contact-icon { width: 1.125rem; height: 1.125rem; flex: 0 0 auto; }
+.contact-wordmark { margin-top: clamp(4rem, 9vw, 8rem); font-size: clamp(2.75rem, 10.2vw, 9rem); font-weight: 500; line-height: 1.04; letter-spacing: -0.065em; white-space: nowrap; }
+.contact-copyright { margin-top: var(--space-3); font-size: 0.75rem; }
