diff --git a/src/components/HomeAurora.css b/src/components/HomeAurora.css
new file mode 100644
index 0000000..69170e4
--- /dev/null
+++ b/src/components/HomeAurora.css
@@ -0,0 +1,75 @@
+.site-shell--home {
+  position: relative;
+  isolation: isolate;
+  overflow-x: clip;
+  --aurora-strength: 0.16;
+  --aurora-deep: #3f2a78;
+  --aurora-purple: #8b5cf6;
+  --aurora-lilac: #a78bfa;
+  --aurora-magenta: #c65ce7;
+}
+:root[data-theme='dark'] .site-shell--home { --aurora-strength: 0.30; }
+.hero-aurora {
+  position: absolute;
+  top: 0;
+  inset-inline: 0;
+  height: clamp(320px, 42svh, 400px);
+  z-index: -1;
+  pointer-events: none;
+  opacity: var(--aurora-strength);
+  /* Broad horizontal field, with a complete fade before the lower boundary. */
+  mask-image:
+    linear-gradient(to bottom, rgb(0 0 0 / 0.2) 0 90px, black 140px, transparent 96%),
+    linear-gradient(to right, transparent, black 8% 92%, transparent);
+  mask-composite: intersect;
+}
+.hero-aurora-field {
+  position: absolute;
+  inset: -90px -5% -50px;
+  transform: translate(var(--aurora-x, 0px), var(--aurora-y, 0px));
+}
+.aurora-band {
+  position: absolute;
+  top: -8%;
+  width: 65%;
+  height: 100%;
+  filter: blur(36px);
+}
+.aurora-band--left {
+  left: -12%;
+  background: radial-gradient(ellipse 65% 48% at 50% 35%, var(--aurora-deep) 12%, var(--color-accent-strong) 38%, transparent 76%);
+}
+.aurora-band--center {
+  left: 18%;
+  background: radial-gradient(ellipse 65% 44% at 50% 30%, var(--aurora-purple) 10%, var(--aurora-lilac) 34%, transparent 75%);
+}
+.aurora-band--right {
+  right: -13%;
+  background: radial-gradient(ellipse 65% 46% at 50% 34%, var(--aurora-magenta) 10%, var(--aurora-purple) 38%, transparent 76%);
+}
+@media (prefers-reduced-motion: no-preference) {
+  .aurora-band { will-change: transform, opacity; }
+  .aurora-band--left { animation: aurora-left 12s ease-in-out -3s infinite alternate; }
+  .aurora-band--center { animation: aurora-center 15s ease-in-out -7s infinite alternate; }
+  .aurora-band--right { animation: aurora-right 18s ease-in-out -11s infinite alternate; }
+}
+@keyframes aurora-left {
+  from { transform: translate(-30px, -10px) scale(1); opacity: 0.85; }
+  to { transform: translate(35px, 12px) scale(1.08); opacity: 1; }
+}
+@keyframes aurora-center {
+  from { transform: translate(25px, 10px) scale(1.06); opacity: 1; }
+  to { transform: translate(-30px, -12px) scale(1); opacity: 0.88; }
+}
+@keyframes aurora-right {
+  from { transform: translate(-20px, 12px) scale(1); opacity: 0.88; }
+  to { transform: translate(30px, -8px) scale(1.07); opacity: 1; }
+}
+@media (max-width: 56rem) { .hero-aurora { height: 320px; } }
+@media (max-width: 40rem) {
+  .hero-aurora { height: 280px; }
+  .aurora-band { filter: blur(24px); }
+}
+@media (prefers-reduced-motion: reduce), (max-width: 56rem), (hover: none), (pointer: coarse) {
+  .hero-aurora-field { transform: none; }
+}
