+.bubble-wipe span { position: absolute; width: var(--bubble-size); height: var(--bubble-size); border-radius: 50%; border: 1px solid var(--color-cosmic-indigo); background: radial-gradient(circle at 28% 25%, color-mix(in srgb, var(--color-cosmic-cyan) 20%, transparent), transparent 35%), color-mix(in srgb, var(--color-accent) 12%, transparent); animation: bubble-pass 650ms var(--motion-easing) var(--bubble-delay) both; }
+@keyframes bubble-pass {
+  0% { opacity: 0; transform: translate(-50%, 55%) scale(0.7); }
+  25% { opacity: 0.85; }
+  100% { opacity: 0; transform: translate(calc(-50% + var(--bubble-drift)), -130%) scale(1.15); }
+}
+@media (prefers-reduced-motion: reduce) { .bubble-wipe { display: none; } }
+@media (max-width: 40rem) { .bubble-wipe span:nth-child(n + 7) { display: none; } }
+
+@media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
+  .project-card:hover .project-card-media img { transform: scale(1.025); }
+  .project-card:hover .project-card-arrow { transform: translate(2px, -2px); }
+}
+@media (prefers-reduced-motion: no-preference) {
+  .project-card-slot[data-revealed='pending'] { opacity: 0.65; transform: scale(1.035); filter: blur(1px); }
+  .project-card-slot[data-revealed='true'] {
+    transform-origin: center;
+    animation: project-settle 850ms cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0ms) backwards;
+  }
+}
+@keyframes project-settle {
+  from { opacity: 0.65; transform: scale(1.035); filter: blur(1px); }
+  to { opacity: 1; transform: scale(1); filter: blur(0); }
+}
+@media (max-width: 56rem) {
+  .project-card-slot--lead, .project-card-slot--closing { grid-column: 1 / -1; grid-row: auto; }
+  .project-card-slot--support, .project-card-slot--support-left { grid-column: span 6; }
+  .project-card-slot--lead .project-card-media { flex: none; aspect-ratio: 16 / 10; }
+  .project-card-slot--closing .project-card-media { flex: none; aspect-ratio: 2 / 1; }
+  .project-card-info { padding: var(--space-2); }
+}
+@media (max-width: 40rem) {
+  .project-card-video { display: none; }
+  .project-index-heading { flex-direction: column; gap: var(--space-1); }
+  .project-index .project-grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
+  .project-card-slot--lead, .project-card-slot--support, .project-card-slot--support-left, .project-card-slot--closing { grid-column: 1; }
+  .project-card-slot .project-card-media { flex: none; aspect-ratio: 4 / 3; }
+  .project-card-slot--closing .project-card-media { aspect-ratio: 16 / 9; }
+}
+
+/* Four published projects: two stacked beside the lead, then a wide closing case. */
+@media (min-width: 56.001rem) {
+  .project-card-slot--closing { grid-column: 1 / -1; grid-row: auto; }
+  .project-card-slot--closing .project-card-media { aspect-ratio: 21 / 9; flex: none; }
+}
