+import './Hero.css'
+
+export default function Hero() {
+  const { t } = useTranslation()
+
+  return (
+    <section className="hero" aria-labelledby="intro-title">
+      <div className="hero-bento">
+        <div className="hero-intro-card">
+          <div className="hero-intro-top">
+            <p>{t('hero.eyebrow', { name: siteConfig.name })}</p>
+            <span className="hero-asterisk" aria-hidden="true">✳</span>
+          </div>
+          <div className="hero-intro-copy">
+            <h1 id="intro-title">{t('hero.headline')}</h1>
+            <p>{t('hero.personality')}</p>
+          </div>
+          <div className="hero-intro-foot">
+            <span>{t('hero.disciplines')}</span>
+            <span>{t(siteConfig.profile.locationKey)} · {t(siteConfig.profile.availabilityKey)}</span>
+          </div>
+        </div>
+
+        <div className="hero-orbit-card" aria-label={t('hero.orbitLabel')}>
+          <div className="hero-orbit-art" aria-hidden="true">
+            <span className="hero-orbit-ring hero-orbit-ring--one" />
+            <span className="hero-orbit-ring hero-orbit-ring--two" />
+            <span className="hero-orbit-ring hero-orbit-ring--three" />
+            <span className="hero-orbit-planet" />
+            <span className="hero-orbit-satellite" />
+          </div>
+          <p>{t('hero.orbitCaption')}</p>
+        </div>
+
+        <div className="hero-interface-card" aria-label={t('hero.interfaceLabel')}>
+          <div className="hero-interface-window" aria-hidden="true">
+            <span className="hero-interface-chrome"><i /><i /><i /></span>
+            <span className="hero-interface-layout"><i /><i /><i /></span>
+            <span className="hero-interface-chart"><i /><i /><i /><i /></span>
+          </div>
+          <p>{t('hero.interfaceLabel')}</p>
+        </div>
+
+        <div className="hero-motion-card" aria-label={t('hero.motionLabel')}>
+          <div className="hero-motion-form" aria-hidden="true"><span /><span /><span /></div>
+          <p>{t('hero.motionLabel')}</p>
+        </div>
+
+        <SectionLink className="hero-action hero-action--work" section="work">
+          <span>{t('hero.selectedWork')}</span><span aria-hidden="true">↗</span>
+        </SectionLink>
+        <SectionLink className="hero-action hero-action--contact" section="contact">
+          <span>{t('navigation.contact')}</span><span aria-hidden="true">↗</span>
+        </SectionLink>
+      </div>
+    </section>
+  )
+}
